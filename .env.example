# Copy to .env and fill in. Nothing here is required to run the test suite —
# only to run the API against a real LLM (or scripts/demo.py).

# Defaults to a local SQLite file; point this at Postgres for production
# (see docker-compose.yml, which provisions Postgres with the pgvector
# extension already installed).
DATABASE_URL=sqlite:///./covenant_iq.db

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# A covenant is "compliant" above this headroom, "early warning" between
# this and zero, "breach" below zero.
EARLY_WARNING_HEADROOM_PCT=10.0

# How many trailing compliance snapshots the trend detector looks at.
TREND_WINDOW=3
